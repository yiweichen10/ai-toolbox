  "special_rules": [
    {
      "match": [
        "人形机器人",
        "具身智能",
        "四足机器人",
        "机器人公司"
      ],
      "force_category": "AI行业应用",
      "note": "人形/具身机器人归AI行业应用，不归AI自动化"
    },
    {
      "match": [
        "智能体构建",
        "Agent框架",
        "多智能体平台"
      ],
      "force_category": "AI智能体",
      "note": "Agent构建平台优先归AI智能体"
    },
    {
      "match": [
        "工作流编排",
        "浏览器自动化",
        "RPA"
      ],
      "force_category": "AI自动化",
      "note": "流程编排/RPA归AI自动化"
    },
    {
      "match": [
        "降AI率",
        "降重",
        "AIGC痕迹",
        "论文查重"
      ],
      "force_category": "AI检测",
      "note": "降AI率/查重类归AI检测"
    },
    {
      "match": [
        "AI学习",
        "AI教程",
        "AI课程",
        "AI入门",
        "学习平台",
        "在线课程"
      ],
      "force_category": "AI学习",
      "note": "AI学习/课程类归AI学习"
    }
  ],
  "fallback_note": "不确定时归最贴近的既有类目；禁止随意堆入'AI效率'，AI效率仅限个人效率/知识管理类。"
